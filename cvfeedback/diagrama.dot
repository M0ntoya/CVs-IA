digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2025-08-05 00:11
  // Cli Options: cvchat --dot -o diagrama.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
    shape = "plaintext"
  ]

  edge [
    fontname = "Roboto"
    fontsize = 8
  ]

